problems/palimpsest/work/raw_pool/*.jsonl  filter=lfs diff=lfs merge=lfs -text
problems/blind-spot/prepared/public/*.csv       filter=lfs diff=lfs merge=lfs -text
problems/galaxy-blind-spot/prepared/public/*.csv filter=lfs diff=lfs merge=lfs -text
dataset-builders/skeinsplit-corpus/*.csv   filter=lfs diff=lfs merge=lfs -text
problems/slate-forensics/data/raw/*.csv     filter=lfs diff=lfs merge=lfs -text
